# 复制为 .env 使用（.env 已被 gitignore，不会提交）
# 本地开发/构建时画廊页读取这些变量；CI 里由仓库 Secrets/Variables 提供

# R2 API Token 的凭据（R2 → Manage R2 API Tokens → Create API Token →
# Object Read 权限），用于构建时列出画廊图片
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Cloudflare Account ID（Dashboard 首页右侧）
CLOUDFLARE_ACCOUNT_ID=709d8f25965da23f0399705900ec2b00
# R2 bucket 名称（如 summer-annual-cdn）
R2_BUCKET=summer-annual-cdn
# R2 公开访问域名（bucket 设置里开启后形如 https://pub-xxxxxxxx.r2.dev）
R2_PUBLIC_BASE=https://pub-5c415e51c3ab4f22a9b5445f197f752d.r2.dev

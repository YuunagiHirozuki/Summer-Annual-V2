# 复制为 .env 使用（.env 已被 gitignore，不会提交）
# 本地开发/构建时画廊页读取这些变量；CI 里由仓库 Secrets/Variables 提供

# Cloudflare API Token：需 Workers R2 Storage 的 Read 权限（构建时列画廊对象）
CLOUDFLARE_API_TOKEN=
# Cloudflare Account ID（Dashboard 首页右侧）
CLOUDFLARE_ACCOUNT_ID=
# R2 bucket 名称（如 summer-annual-cdn）
R2_BUCKET=
# R2 公开访问域名（bucket 设置里开启后形如 https://pub-xxxxxxxx.r2.dev）
R2_PUBLIC_BASE=

---
import '../styles/global.css'
import { ClientRouter } from 'astro:transitions'
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Hero from '../components/Hero.astro'
import HalfHero from '../components/HalfHero.astro'
import About from '../components/About.astro'
import Contact from '../components/Contact.astro'
import BackToTop from '../components/BackToTop.astro'

interface Props {
    title: string
    description?: string
    /** hero 封面：full = 全屏（首页），half = 半屏（内页），none = 无（文章页/404） */
    hero?: 'full' | 'half' | 'none'
    /** 半屏封面图 / og:image */
    heroImage?: string
}

const { title, description, hero = 'half', heroImage } = Astro.props
---

<html lang="zh-Hans">
    <head>
        <BaseHead title={title} description={description} image={heroImage} />
        <ClientRouter />

        <script is:inline>
            // 主题初始化：在首帧绘制前应用，避免闪烁；ClientRouter 换页后重新应用
            // 黑夜模式为默认（不设置时 CSS :root 即深色 token）
            function applyTheme() {
                document.documentElement.dataset.theme =
                    localStorage.getItem('theme') || 'dark'
            }
            applyTheme()
            document.addEventListener('astro:after-swap', applyTheme)
        </script>
    </head>

    <body
        id="top"
        class:list={['bg-background text-ink', hero !== 'none' && 'has-hero']}
    >
        <Header transition:persist />

        {
            hero === 'full' ? (
                <Hero />
            ) : hero === 'half' ? (
                <HalfHero image={heroImage ?? '/src/assets/images/halfcover.png'} />
            ) : null
        }

        <main id="main" class:list={['w-full', hero === 'none' && 'pt-16']}>
            <slot />
        </main>

        <About />

        <Contact />

        <BackToTop transition:persist />

        <Footer />
    </body>
</html>

---
import type { ImageMetadata } from 'astro'
import CoverImage from '../components/CoverImage.astro'
import TOC from '../components/TOC.astro'
import { postCoverSrc, type Post } from '../utils/posts'

interface Props {
    post: Post
    prev?: Post
    next?: Post
}

const { post, prev, next } = Astro.props
const { title, pubDate, updatedDate, tags } = post.data
const rawImage = post.data.image as string | ImageMetadata | undefined
const cover = postCoverSrc(post)
---

<!-- 文章页正文骨架：由页面放进 BaseLayout 的 <main> 里 -->
<!-- 三列 grid：左右 1fr 等宽 → 文章精确居中，目录恒距 32px -->
<div
    class="mx-auto grid w-full grid-cols-1 gap-6 px-4 py-12 xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]"
>
    <div class="hidden xl:block" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-180 min-w-0">
        <article class="w-full overflow-hidden rounded-sm bg-card shadow-xs">
            <!-- 顶部头图（构建时缩到 1380px webp，避免浏览器缩放锯齿） -->
            {
                cover && (
                    <div class="relative aspect-[16/9] w-full overflow-hidden">
                        <CoverImage
                            image={rawImage}
                            alt={title}
                            width={1380}
                            loading="eager"
                            class="h-full w-full object-cover"
                        />
                    </div>
                )
            }

            <!-- 正文内容区域 -->
            <div class="px-6 py-11 sm:px-11">
                <header class="mb-10 text-left">
                    <h1 class="mb-1 text-3xl font-bold sm:text-4xl">{title}</h1>
                    <p class="text-sm text-muted">
                        {pubDate.toLocaleDateString('zh-CN')}
                        {
                            updatedDate && (
                                <span class="ml-2 italic">
                                    (更新于{' '}
                                    {updatedDate.toLocaleDateString('zh-CN')})
                                </span>
                            )
                        }
                    </p>
                </header>

                <!-- 正文内容 -->
                <div class="md-content">
                    <slot />
                </div>

                <!-- 标签区域 -->
                {
                    tags && tags.length > 0 && (
                        <div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
                            {tags.map((tag: string) => (
                                <a
                                    href={`/tags/${encodeURIComponent(tag)}/`}
                                    class="rounded-full bg-tag-bg px-3 py-1 text-sm text-muted no-underline transition-colors hover:text-aqua"
                                >
                                    #{tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>

            <!-- 评论区（可放 Giscus 等） -->
            <div class="px-6 pb-10 sm:px-10">
                <h2 class="mb-4 text-lg font-semibold">Comments</h2>
                <div id="comments" class="italic text-muted">
                    Coming soon...
                </div>
            </div>

            <!-- 上/下篇导航：三等宽栅格，长标题自动换行 -->
            <nav
                class="grid grid-cols-3 items-center gap-4 border-t border-border px-6 py-8 text-sm text-muted sm:px-10"
            >
                {
                    prev ? (
                        <a
                            href={`/posts/${prev.id}/`}
                            class="justify-self-start text-left transition hover:text-aqua"
                        >
                            &larr; {prev.data.title}
                        </a>
                    ) : (
                        <span />
                    )
                }

                <div
                    class="flex min-h-12 items-center justify-self-center self-stretch border-x border-border px-12"
                >
                    <a
                        href="/"
                        class="text-center transition hover:text-aqua"
                    >
                        All Posts
                    </a>
                </div>

                {
                    next ? (
                        <a
                            href={`/posts/${next.id}/`}
                            class="justify-self-end text-right transition hover:text-aqua"
                        >
                            {next.data.title} &rarr;
                        </a>
                    ) : (
                        <span />
                    )
                }
            </nav>
        </article>
    </div>

    <!-- 桌面端浮动目录 -->
    <TOC />
</div>

<script>
    // 代码块：语言标签单独占顶栏一行，右侧复制按钮为 icon
    function initCodeBlocks() {
        document.querySelectorAll<HTMLPreElement>('.md-content pre').forEach((pre) => {
            if (pre.dataset.toolbar) return
            pre.dataset.toolbar = '1'

            const code = pre.querySelector('code')
            const lang =
                pre.getAttribute('data-language') ||
                code?.className.match(/language-([\w-]+)/)?.[1] ||
                ''

            // 外壳：顶栏（语言 + 复制 icon）+ 代码
            const wrapper = document.createElement('div')
            wrapper.className = 'code-block'

            const header = document.createElement('div')
            header.className = 'code-header'

            const label = document.createElement('span')
            label.className = 'code-lang'
            label.textContent = lang
            header.appendChild(label)

            const btn = document.createElement('button')
            btn.type = 'button'
            btn.className = 'code-copy'
            btn.setAttribute('aria-label', '复制')
            btn.innerHTML = '<i class="mi-copy"></i>'
            btn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(code?.innerText ?? '')
                    btn.innerHTML = '<i class="mi-check"></i>'
                } catch {
                    btn.innerHTML = '<i class="mi-warning"></i>'
                }
                setTimeout(() => {
                    btn.innerHTML = '<i class="mi-copy"></i>'
                }, 1500)
            })
            header.appendChild(btn)

            pre.replaceWith(wrapper)
            wrapper.appendChild(header)
            wrapper.appendChild(pre)
        })
    }

document.addEventListener('astro:page-load', initCodeBlocks)
</script>

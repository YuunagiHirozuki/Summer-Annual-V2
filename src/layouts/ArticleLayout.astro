---
import type { ImageMetadata } from 'astro'
import CoverImage from '../components/CoverImage.astro'
import TOC from '../components/TOC.astro'
import Waline from '../components/Waline.astro'
import {
    formatDate,
    getSortedPosts,
    postCoverSrc,
    type Post,
} from '../utils/posts'

interface Props {
    post: Post
    prev?: Post
    next?: Post
}

const { post, prev, next } = Astro.props
const { title, pubDate, updatedDate, tags } = post.data
const rawImage = post.data.image as string | ImageMetadata | undefined
const categoryPosts = post.data.categories
    ? (await getSortedPosts()).filter(
          (p) => p.data.categories === post.data.categories
      )
    : []
const cover = postCoverSrc(post)
---

<!-- 文章页正文骨架：由页面放进 BaseLayout 的 <main> 里 -->
<!-- 三列 grid：左右 1fr 等宽 → 文章精确居中，目录恒距 32px -->
<div
    class="mx-auto grid w-full grid-cols-1 gap-6 px-4 py-12 xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)]"
>
    <div class="hidden xl:block" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-180 min-w-0">
        <article class="w-full overflow-hidden rounded-sm bg-card shadow-xs">
            <!-- 顶部头图（构建时缩到 1380px webp，避免浏览器缩放锯齿） -->
            {
                cover && (
                    <div class="relative aspect-[16/9] w-full overflow-hidden">
                        <CoverImage
                            image={rawImage}
                            alt={title}
                            width={1380}
                            loading="eager"
                            class="h-full w-full object-cover"
                        />
                    </div>
                )
            }

            <!-- 正文内容区域 -->
            <div class="px-6 py-11 sm:px-11">
                <header class="mb-10 text-left">
                    <h1 class="mb-1 text-3xl font-bold sm:text-4xl">{title}</h1>
                    <p class="text-sm text-muted">
                        {formatDate(pubDate)}
                        {
                            updatedDate && (
                                <span class="ml-2 italic">
                                    (更新于{' '}
                                    {formatDate(updatedDate)})
                                </span>
                            )
                        }
                    </p>
                </header>

                <!-- 正文内容 -->
                <div class="md-content">
                    <slot />
                </div>

                <!-- 标签区域 -->
                {
                    tags && tags.length > 0 && (
                        <div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
                            {tags.map((tag: string) => (
                                <a
                                    href={`/tags/${encodeURIComponent(tag)}/`}
                                    class="rounded-full bg-tag-bg px-3 py-1 text-sm text-muted no-underline transition-colors hover:text-aqua"
                                >
                                    #{tag}
                                </a>
                            ))}
                        </div>
                    )
                }
            </div>

            <!-- 评论区 -->
            <div class="px-6 pb-10 sm:px-10">
                <div class="mb-2 text-lg font-semibold">
                    <span>Comments</span>
                    <span
                        class="waline-comment-count hidden rounded-full bg-border px-2 py-0.5 text-xs font-normal text-muted"
                        data-path={Astro.url.pathname}
                    ></span>
                </div>
                <Waline />
            </div>

            <!-- 上/下篇导航：三等宽栅格，长标题自动换行 -->
            <nav
                class="grid grid-cols-3 items-center gap-4 border-t border-border px-6 py-8 text-sm text-muted sm:px-10"
            >
                {
                    prev ? (
                        <a
                            href={`/posts/${prev.id}/`}
                            class="justify-self-start text-left transition hover:text-aqua"
                        >
                            &larr; {prev.data.title}
                        </a>
                    ) : (
                        <span />
                    )
                }

                <div
                    class="flex min-h-12 items-center justify-self-center self-stretch border-x border-border px-12"
                >
                    <a
                        href="/"
                        class="text-center transition hover:text-aqua"
                    >
                        All Posts
                    </a>
                </div>

                {
                    next ? (
                        <a
                            href={`/posts/${next.id}/`}
                            class="justify-self-end text-right transition hover:text-aqua"
                        >
                            {next.data.title} &rarr;
                        </a>
                    ) : (
                        <span />
                    )
                }
            </nav>
        </article>
    </div>

    <!-- 桌面端浮动目录 -->
    <div class="flex w-full flex-col gap-4 self-start xl:sticky xl:top-24 xl:w-72 xl:shrink-0">
        <TOC />

        {
            categoryPosts.length > 0 && (
                <div class="rounded-sm bg-surface p-4 shadow-xs text-sm">
                    <h2 class="mb-3 text-base font-semibold">
                        {post.data.categories}
                    </h2>
                    <ul class="space-y-1">
                        {categoryPosts.map((p) => (
                            <li>
                                <a
                                    href={`/posts/${p.id}/`}
                                    class:list={[
                                        'flex items-baseline justify-between gap-2 rounded px-2 py-1 no-underline transition-colors hover:text-aqua',
                                        p.id === post.id
                                            ? 'bg-tag-bg text-ink'
                                            : 'text-muted',
                                    ]}
                                >
                                    <span class="truncate">
                                        {p.data.title}
                                    </span>
                                    <span class="shrink-0 text-xs">
                                        {formatDate(p.data.pubDate)}
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            )
        }
    </div>
</div>

<script>
    import '../../scripts/code-blocks'
</script>
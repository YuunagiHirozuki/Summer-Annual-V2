---
import TOC from '../components/TOC.astro'
import { postCoverSrc, type Post } from '../utils/posts'

interface Props {
    post: Post
    prev?: Post
    next?: Post
}

const { post, prev, next } = Astro.props
const { title, pubDate, updatedDate, tags } = post.data
const cover = postCoverSrc(post)
---

<!-- 文章页正文骨架：由页面放进 BaseLayout 的 <main> 里 -->
<div class="flex justify-center gap-8 px-4 py-12">
    <div class="w-full max-w-[690px]">
        <article class="w-full overflow-hidden rounded-sm bg-card shadow-xl">
            <!-- 顶部头图 -->
            {
                cover && (
                    <div class="relative aspect-[16/9] w-full overflow-hidden">
                        <img
                            src={cover}
                            alt={title}
                            width="1920"
                            height="1080"
                            loading="lazy"
                            decoding="async"
                            class="h-full w-full object-cover"
                        />
                    </div>
                )
            }

            <!-- 正文内容区域 -->
            <div class="px-6 py-11 sm:px-11">
                <header class="mb-10 text-left">
                    <h1 class="mb-1 text-3xl font-bold sm:text-4xl">{title}</h1>
                    <p class="text-sm text-muted">
                        {pubDate.toLocaleDateString('zh-CN')}
                        {
                            updatedDate && (
                                <span class="ml-2 italic">
                                    (更新于{' '}
                                    {updatedDate.toLocaleDateString('zh-CN')})
                                </span>
                            )
                        }
                    </p>
                </header>

                <!-- 正文内容 -->
                <div class="md-content">
                    <slot />
                </div>

                <!-- 标签区域 -->
                {
                    tags && tags.length > 0 && (
                        <div class="mt-10 flex flex-wrap gap-2 border-t border-border pt-6">
                            {tags.map((tag: string) => (
                                <span class="rounded-full bg-tag-bg px-3 py-1 text-sm text-muted">
                                    #{tag}
                                </span>
                            ))}
                        </div>
                    )
                }
            </div>

            <!-- 评论区（可放 Giscus 等） -->
            <div class="px-6 pb-10 sm:px-10">
                <h2 class="mb-4 text-lg font-semibold">Comments</h2>
                <div id="comments" class="italic text-muted">
                    Coming soon...
                </div>
            </div>

            <!-- 上/下篇导航 -->
            <nav
                class="flex items-center justify-between gap-4 border-t border-border px-6 py-8 text-sm text-muted sm:px-10"
            >
                {
                    prev ? (
                        <a
                            href={`/posts/${prev.id}/`}
                            class="transition hover:text-aqua"
                        >
                            &larr; {prev.data.title}
                        </a>
                    ) : (
                        <span />
                    )
                }

                <a href="/" class="transition hover:text-aqua">All Posts</a>

                {
                    next ? (
                        <a
                            href={`/posts/${next.id}/`}
                            class="transition hover:text-aqua"
                        >
                            {next.data.title} &rarr;
                        </a>
                    ) : (
                        <span />
                    )
                }
            </nav>
        </article>
    </div>

    <!-- 桌面端浮动目录 -->
    <TOC />
</div>

<script>
    // 代码块工具条：语言标签 + 复制按钮（hover 浮现，样式在 prose.css）
    function initCodeToolbars() {
        document.querySelectorAll('.md-content pre').forEach((pre) => {
            if (pre.dataset.toolbar) return
            pre.dataset.toolbar = '1'

            const toolbar = document.createElement('div')
            toolbar.className = 'code-toolbar'

            const code = pre.querySelector('code')
            const lang =
                pre.getAttribute('data-language') ||
                code?.className.match(/language-([\w-]+)/)?.[1] ||
                ''
            if (lang) {
                const label = document.createElement('span')
                label.className = 'code-lang'
                label.textContent = lang
                toolbar.appendChild(label)
            }

            const btn = document.createElement('button')
            btn.type = 'button'
            btn.className = 'code-copy'
            btn.textContent = '复制'
            btn.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(code?.innerText ?? '')
                    btn.textContent = '已复制'
                } catch {
                    btn.textContent = '复制失败'
                }
                setTimeout(() => {
                    btn.textContent = '复制'
                }, 1500)
            })
            toolbar.appendChild(btn)

            pre.appendChild(toolbar)
        })
    }

    document.addEventListener('astro:page-load', initCodeToolbars)
</script>

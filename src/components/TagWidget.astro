---
import { getSortedPosts, getTagCounts } from '../utils/posts'

const posts = await getSortedPosts()
const tags = getTagCounts(posts)
---

{
    tags.length > 0 && (
        <section class="rounded-sm bg-surface p-4 shadow-xs">
            <h2 class="mb-3 text-base font-semibold">TAGS</h2>
            <ul class="flex flex-wrap gap-2">
                {tags.map(([tag, count]) => (
                    <li>
                        <a
                            href={`/tags/${encodeURIComponent(tag)}/`}
                            class="flex items-baseline gap-1.5 rounded-full bg-tag-bg px-3 py-1 no-underline transition-colors duration-300 hover:text-aqua"
                        >
                            <span class="text-sm text-ink">#{tag}</span>
                            <span class="text-xs text-muted">{count}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    )
}

---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
    image: string | ImageMetadata
    alt: string
    /** 构建时缩放的目标宽度（仅对文章自带图片生效） */
    width?: number
    class?: string
    loading?: 'lazy' | 'eager'
}

const { image, alt, width = 800, class: className, loading = 'lazy' } =
    Astro.props
---

{
    typeof image === 'string' ? (
        <img src={image} alt={alt} loading={loading} class={className} />
    ) : (
        <Image
            src={image}
            alt={alt}
            width={width}
            format="webp"
            loading={loading}
            class={className}
        />
    )
}

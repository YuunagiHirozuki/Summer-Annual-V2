---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
    image?: string | ImageMetadata
    alt: string
    class?: string
    loading?: 'lazy' | 'eager'
}

const { image, alt, class: className, loading = 'lazy' } = Astro.props
---

{
    image &&
        (typeof image === 'string' ? (
            <img src={image} alt={alt} loading={loading} class={className} />
        ) : (
            <Image
                src={image}
                alt={alt}
                loading={loading}
                class={className}
            />
        ))
}

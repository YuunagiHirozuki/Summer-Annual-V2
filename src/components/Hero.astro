---
import { SITE_SIGNATURE, SITE_TITLE } from '../consts'
---

<!-- 首页/文章页的全屏封面 -->
<div class="relative h-screen w-full">
    <a href="#main" class="block h-full w-full">
        <section
            id="hero"
            class="relative flex h-screen w-full flex-col items-center justify-center bg-cover bg-center text-white"
            style="background-image: url('/images/cover.jpg');"
        >
            <div class="relative z-10 mx-auto max-w-4xl px-4 text-right">
                <h1 class="text-3xl font-bold text-on-hero text-shadow-lg/30 sm:text-4xl md:text-5xl">
                    {SITE_TITLE}
                </h1>
                <p class="mt-3 text-base text-on-hero text-shadow-lg/30 sm:text-lg md:text-xl">
                    这里是世界的某一角落，仅此而已
                </p>
            </div>
        </section>
    </a>

    <!-- 下滑按钮 -->
    <a
        href="#main"
        id="scroll-down-btn"
        class="absolute bottom-2 left-1/2 z-10 text-4xl text-on-hero text-shadow-lg/30 transition duration-300 animate-float-breathe"
        aria-label="向下滚动"
    >
        <i class="mi-chevron-down"></i>
    </a>
</div>

---
import { Image } from 'astro:assets'
import { type Post } from '../utils/posts'

interface Props {
    post: Post
    /** 列表中的序号：奇数行图片放右侧，形成左右交替 */
    index?: number
}

const { post, index = 0 } = Astro.props
const reverse = index % 2 === 1
const raw = post.data.image
---

<a
    href={`/posts/${post.id}/`}
    class:list={[
        'group flex flex-col items-center overflow-hidden rounded-sm bg-card shadow-md transition-all duration-300 hover:shadow-lg sm:flex-row sm:items-stretch',
        { 'sm:flex-row-reverse': reverse },
    ]}
>
    {/* 左侧图片（奇数行在右）；构建时缩到 800px webp，避免浏览器缩放锯齿 */}
    {
        raw && (
            <div class="h-44 w-full shrink-0 overflow-hidden sm:h-44 sm:w-2/5">
                {typeof raw === 'string' ? (
                    <img
                        src={raw}
                        alt={post.data.title}
                        loading="lazy"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                ) : (
                    <Image
                        src={raw}
                        alt={post.data.title}
                        width={800}
                        format="webp"
                        loading="lazy"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                )}
            </div>
        )
    }

    {/* 右侧文字部分 */}
    <div class="flex w-full flex-col justify-center p-6 sm:w-3/5">
        <h3
            class="mb-2 text-2xl font-bold transition-colors duration-300 group-hover:text-aqua"
        >
            {post.data.title}
        </h3>
        <p class="mb-2 text-sm opacity-70">
            {post.data.pubDate.toLocaleDateString('zh-CN')}
            {post.data.categories && `｜📂 ${post.data.categories}`}
        </p>
        <p class="text-base leading-relaxed opacity-90">
            {post.data.description}
        </p>
        {
            post.data.tags && (
                <div class="mt-3 flex flex-wrap gap-2 text-sm">
                    {post.data.tags.map((tag: string) => (
                        <span class="rounded-md bg-tag-bg px-2 py-1 opacity-80 transition-colors duration-300 hover:text-aqua">
                            #{tag}
                        </span>
                    ))}
                </div>
            )
        }
    </div>
</a>

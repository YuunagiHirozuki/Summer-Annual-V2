---
import type { Post } from '../utils/posts'

interface Props {
    post: Post
}

const { post } = Astro.props
---

<a
    href={`/posts/${post.id}/`}
    class="group flex flex-col items-center overflow-hidden rounded-sm bg-card shadow-md transition-all duration-300 hover:shadow-lg sm:flex-row sm:items-start"
>
    {/* 左侧图片 */}
    {
        post.data.image && (
            <div class="h-48 w-full overflow-hidden sm:h-auto sm:w-1/3">
                <img
                    src={post.data.image}
                    alt={post.data.title}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
            </div>
        )
    }

    {/* 右侧文字部分 */}
    <div class="flex w-full flex-col justify-between p-6 sm:w-2/3">
        <h3
            class="mb-2 text-2xl font-bold transition-colors duration-300 group-hover:text-aqua"
        >
            {post.data.title}
        </h3>
        <p class="mb-2 text-sm opacity-70">
            {post.data.pubDate.toLocaleDateString('zh-CN')}
            {post.data.categories && `｜📂 ${post.data.categories}`}
        </p>
        <p class="text-base leading-relaxed opacity-90">
            {post.data.description}
        </p>
        {
            post.data.tags && (
                <div class="mt-3 flex flex-wrap gap-2 text-sm">
                    {post.data.tags.map((tag: string) => (
                        <span class="rounded-md bg-tag-bg px-2 py-1 opacity-80 transition-colors duration-300 hover:text-aqua">
                            #{tag}
                        </span>
                    ))}
                </div>
            )
        }
    </div>
</a>

---
import CoverImage from './CoverImage.astro'
import { formatDate, type Post } from '../utils/posts'

interface Props {
    post: Post
}

const { post } = Astro.props
const raw = post.data.image
const href = `/posts/${post.id}/`
---

{/* 根元素不能用 <a>：卡片内的标签也要是链接，HTML 不允许链接嵌套 */}
<div
    class="group block overflow-hidden rounded-sm bg-card shadow-xs transition-all duration-300 hover:shadow-sm"
>
    {/* 封面在上（16:9 统一裁切），构建时缩到 1200px webp */}
    {
        raw && (
            <a
                href={href}
                class="block aspect-[16/9] w-full overflow-hidden"
                aria-label={post.data.title}
            >
                <CoverImage
                    image={raw}
                    alt={post.data.title}
                    width={1200}
                    class="h-full w-full object-cover transition-transform duration-300"
                />
            </a>
        )
    }

    <div class="p-6">
        <h3
            class="mb-2 text-2xl font-bold transition-colors duration-300 group-hover:text-aqua"
        >
            {post.data.pinned && (
                <i
                    class="mi-pin inline-block align-middle text-aqua"
                    title="置顶"
                />
            )}
            <a href={href} class="no-underline transition-colors duration-300">
                {post.data.title}
            </a>
        </h3>
        <p class="mb-2 text-sm opacity-70">
            {formatDate(post.data.pubDate)}
            {post.data.categories && `· ${post.data.categories}`}
        </p>
        <p class="text-base leading-relaxed opacity-90">
            {post.data.description}
        </p>
        {
            post.data.tags && (
                <div class="mt-3 flex flex-wrap gap-2 text-sm">
                    {post.data.tags.map((tag: string) => (
                        <a
                            href={`/tags/${encodeURIComponent(tag)}/`}
                            class="rounded-md bg-tag-bg px-2 py-1 no-underline opacity-80 transition-colors duration-300 hover:text-aqua"
                        >
                            #{tag}
                        </a>
                    ))}
                </div>
            )
        }
    </div>
</div>

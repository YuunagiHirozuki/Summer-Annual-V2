---
import { SITE_TITLE } from '../consts'
import LogoLight from '../assets/images/SummerAnnual_Light.svg'
import LogoDark from '../assets/images/SummerAnnual_Dark.svg'
import HeaderLink from './HeaderLink.astro'
import { Icon } from 'astro-icon/components'

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '')
const subpath = pathname.match(/[^/]+/g)
const isActive = (href: string) =>
    href === pathname || href === '/' + (subpath?.[0] || '')

const links = [
    { href: '/', label: 'BLOG' },
    { href: '/projects', label: 'PROJECTS' },
    { href: '/gallery', label: 'GALLERY' },
    { href: '#about', label: 'ABOUT' },
    { href: '#contact', label: 'CONTACT' },
    { href: '/archive', label: 'ARCHIVE' },
]
---

<nav
    id="navbar"
    class="fixed top-0 z-50 w-full bg-transparent px-4 py-4 transition-all duration-300"
>
    <div class="flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="shrink-0">
            <a href="/" class="block no-underline">
                <img
                    src={LogoLight.src}
                    alt={SITE_TITLE}
                    class="logo-light h-11 w-auto max-w-none"
                />
                <img
                    src={LogoDark.src}
                    alt={SITE_TITLE}
                    class="logo-dark h-11 w-auto max-w-none"
                />
            </a>
        </div>

        <!-- 桌面端链接 -->
        <div class="hidden space-x-15 text-base lg:flex">
            {
                links.map((l) => (
                    <HeaderLink href={l.href}>{l.label}</HeaderLink>
                ))
            }
        </div>

        <div class="flex shrink-0 items-center gap-2">
            <!-- 站内搜索 -->
            <button
                type="button"
                data-search-toggle
                aria-label="搜索"
                class="flex h-8 w-8 items-center justify-center rounded-full transition-colors duration-300 hover:bg-ink hover:text-aqua"
            >
                <Icon name="mdi:search" class="text-xl" />
            </button>

            <!-- 白天/黑夜切换 -->
            <button
                type="button"
                data-theme-toggle
                aria-label="切换白天/黑夜模式"
                class="flex h-8 w-8 items-center justify-center rounded-full transition-colors duration-300 hover:bg-ink hover:text-aqua"
            >
                <Icon
                    name="mdi:weather-night"
                    class="theme-icon-dark text-xl"
                />
                <Icon
                    name="mdi:white-balance-sunny"
                    class="theme-icon-light text-xl"
                />
            </button>

            <!-- 移动端菜单按钮 -->
            <button
                type="button"
                id="menu-btn"
                aria-label="打开菜单"
                aria-expanded="false"
                aria-controls="mobile-drawer"
                class="flex h-8 w-8 items-center justify-center rounded-full transition-colors duration-300 hover:bg-ink hover:text-aqua lg:hidden"
            >
                <Icon name="mdi:menu" class="text-xl" />
            </button>
        </div>
    </div>
</nav>

<!-- 搜索面板：导航栏下方的卡片 -->
<div id="search-panel" class="fixed inset-x-0 top-0 z-40 hidden px-4 pt-24">
    <div
        class="mx-auto max-h-[85vh] max-w-2xl overflow-y-auto rounded-sm border border-border bg-surface p-4 shadow-lg"
    >
        <!-- 搜索框 -->
        <div class="relative top-2">
            <input
                id="search-input"
                type="search"
                placeholder="Search"
                aria-label="搜索本站"
                autocomplete="off"
                class="w-full rounded-sm border border-border bg-surface px-4 py-2 pr-12 text-ink outline-none transition-colors focus:border-aqua"
            />

            <button
                id="search-submit"
                type="button"
                aria-label="搜索"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-muted transition-colors hover:text-aqua"
            >
                <Icon name="mdi:search" class="text-xl" />
            </button>
        </div>

        <!-- 搜索状态 -->
        <p
            id="search-status"
            class="mt-6 hidden text-sm text-muted"
        ></p>

        <!-- 搜索结果 -->
        <div id="search-results" class="mt-4"></div>
    </div>
</div>

<!-- 抽屉遮罩 -->
<div id="drawer-backdrop" class="fixed inset-0 z-40 bg-black/50 lg:hidden">
</div>

<!-- 抽屉：从右侧滑出 -->
<aside
    id="mobile-drawer"
    class="fixed right-0 top-0 z-50 h-full w-64 bg-surface shadow-xl lg:hidden"
    aria-label="站点导航"
>
    <div class="flex h-full flex-col gap-1 overflow-y-auto p-6 pt-20">
        {
            links.map((l) => (
                <a
                    href={l.href}
                    class:list={[
                        'block rounded px-3 py-2 text-base no-underline transition-colors duration-300 hover:text-aqua',
                        isActive(l.href) ? 'text-aqua' : 'text-ink',
                    ]}
                >
                    {l.label}
                </a>
            ))
        }
    </div>
</aside>

<style>
    /* 滚动后导航条变实底（由脚本切换 .nav--scrolled） */
    .nav--scrolled {
        background-color: color-mix(
            in srgb,
            var(--background) 90%,
            transparent
        );
        box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 0.1),
            0 2px 4px -2px rgb(0 0 0 / 0.1);
    }

    /* 抽屉默认收起，.drawer-open 时滑出（从右侧） */
    #mobile-drawer {
        transform: translateX(100%);
        transition: transform 0.3s ease;
    }

    #mobile-drawer.drawer-open {
        transform: translateX(0);
    }

    #drawer-backdrop {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    #drawer-backdrop.drawer-open {
        opacity: 1;
        pointer-events: auto;
    }
</style>

<style is:global>
    /* 按当前主题显示对应的切换图标 */
    html[data-theme='dark'] .theme-icon-light {
        display: none;
    }
    html[data-theme='light'] .theme-icon-dark {
        display: none;
    }

    /* Logo 同理：Light 版（白色）配黑夜模式，Dark 版配白天模式 */
    html[data-theme='dark'] .logo-dark {
        display: none;
    }
    html[data-theme='light'] .logo-light {
        display: none;
    }

    /* 悬浮在 hero 上方（未滚动）时，导航文字/图标跟随 --on-hero，
       不随主题切换变色；滚动出 hero 后用常规 --ink */
    body.has-hero #navbar:not(.nav--scrolled) {
        color: var(--on-hero);
    }
    #navbar.nav--scrolled {
        color: var(--ink);
    }

    #search-results mark {
        color: var(--aqua);
        background-color: color-mix(in srgb, var(--aqua) 15%, transparent);
        border-radius: 0.2rem;
        padding: 0.05em 0.2em;
    }
</style>

<script>
    // ===== 白天/黑夜切换：事件委托，ClientRouter 换页后依旧有效 =====
    document.addEventListener('click', (event) => {
        const target =
            event.target instanceof Element ? event.target : null
        if (!target?.closest('[data-theme-toggle]')) return
        const next =
            document.documentElement.dataset.theme === 'light'
                ? 'dark'
                : 'light'
        document.documentElement.dataset.theme = next
        localStorage.setItem('theme', next)
    })

    // ===== 移动端抽屉菜单 =====
    // 全部用 document 级事件委托：ClientRouter 换页会替换按钮/抽屉节点，
    // 绑在节点上的监听器会随旧节点丢失，委托则始终有效
    function setDrawer(open: boolean) {
        document
            .getElementById('mobile-drawer')
            ?.classList.toggle('drawer-open', open)
        document
            .getElementById('drawer-backdrop')
            ?.classList.toggle('drawer-open', open)
        document
            .getElementById('menu-btn')
            ?.setAttribute('aria-expanded', String(open))
    }

    document.addEventListener('click', (event) => {
        const target =
            event.target instanceof Element ? event.target : null
        if (!target) return
        if (target.closest('#menu-btn')) {
            setDrawer(true)
        } else if (
            target.closest('#drawer-backdrop') ||
            target.closest('#mobile-drawer a')
        ) {
            setDrawer(false)
        }
    })

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setDrawer(false)
    })

    // ===== 导航条：滚过阈值变实底；滑过 hero 后下滑隐藏、上滑出现 =====
    let heroHeight = 400
    let lastScrollY = 0
    let ticking = false

    function updateNavStyle(nav: HTMLElement) {
        const y = window.scrollY
        nav.classList.toggle('nav--scrolled', y > 60)

        if (y > heroHeight) {
            nav.style.transform =
                y > lastScrollY ? 'translateY(-100%)' : 'translateY(0)'
        } else {
            nav.style.transform = 'translateY(0)'
        }
        lastScrollY = y
        ticking = false
    }

    function initHeader() {
        const nav = document.getElementById('navbar')
        if (!nav) return

        // 换页后抽屉恢复收起
        setDrawer(false)

        // 每次换页重新测量 hero 高度
        heroHeight = (document.querySelector('#hero') as HTMLElement | null)?.offsetHeight ?? 400

        if (!nav.dataset.bound) {
            nav.dataset.bound = '1'

            window.addEventListener(
                'scroll',
                () => {
                    if (!ticking) {
                        window.requestAnimationFrame(() => updateNavStyle(nav))
                        ticking = true
                    }
                },
                { passive: true }
            )
            window.addEventListener('resize', () => {
                heroHeight = (document.querySelector('#hero') as HTMLElement | null)?.offsetHeight ?? 400
            })
        }
        updateNavStyle(nav)
    }

    document.addEventListener('astro:page-load', initHeader)
</script>


<script is:inline type="module">
    // ===== 站内搜索 =====

    let pagefind = null

    async function loadPagefind() {
        if (pagefind) return pagefind

        try {
            pagefind = await import('/pagefind/pagefind.js')
            return pagefind
        } catch {
            return null
        }
    }

    function setSearchOpen(open) {
        const searchPanel = document.getElementById('search-panel')
        const searchInput =
            document.getElementById('search-input')

        searchPanel?.classList.toggle('hidden', !open)

        if (open) {
            searchInput?.focus()
        }
    }

    async function performSearch(query) {
        const searchResults =
            document.getElementById('search-results')
        const searchStatus =
            document.getElementById('search-status')

        if (!searchResults || !searchStatus) return

        const keyword = query.trim()

        if (!keyword) {
            searchResults.innerHTML = ''
            searchStatus.classList.add('hidden')
            return
        }

        searchStatus.textContent = '搜索中…'
        searchStatus.classList.remove('hidden')
        searchResults.innerHTML = ''

        const pf = await loadPagefind()

        if (!pf) {
            searchStatus.textContent =
                '搜索索引未构建，请运行 pnpm build 后使用 pnpm preview 查看。'
            return
        }

        try {
            const search = await pf.search(keyword)

            searchStatus.textContent = search.results.length
                ? `找到 ${search.results.length} 条结果`
                : `没有找到「${keyword}」相关内容`

            const results = await Promise.all(
                search.results.map((result) => result.data()),
            )

            for (const data of results) {
                const article = document.createElement('a')

                article.href = data.url
                article.className =
                    'block border-b border-border px-3 py-3 rounded-sm no-underline transition-colors last:border-b-0 hover:text-aqua hover:bg-ink/5'

                const title = document.createElement('h3')
                title.className =
                    'text-base font-medium text-ink'
                title.textContent =
                    data.meta?.title ?? '无标题'

                const excerpt = document.createElement('p')
                excerpt.className =
                    'mt-1 text-sm leading-relaxed text-muted'
                excerpt.innerHTML =
                    data.excerpt ?? ''

                article.append(title, excerpt)
                searchResults.appendChild(article)
            }
        } catch {
            searchStatus.textContent = '搜索失败。'
            searchResults.innerHTML = ''
        }
    }

    let searchTimer = null

    document.addEventListener('input', (event) => {
        const target = event.target

        if (!(target instanceof HTMLInputElement)) return
        if (target.id !== 'search-input') return

        if (searchTimer) {
            clearTimeout(searchTimer)
        }

        searchTimer = setTimeout(() => {
            void performSearch(target.value)
        }, 200)
    })

    document.addEventListener('click', (event) => {
        const target =
            event.target instanceof Element
                ? event.target
                : null

        if (!target) return

        if (target.closest('[data-search-toggle]')) {
            const searchPanel =
                document.getElementById('search-panel')

            const isHidden =
                searchPanel?.classList.contains('hidden') ?? true

            setSearchOpen(isHidden)
            return
        }

        if (target.closest('#search-submit')) {
            const searchInput =
                document.getElementById('search-input')

            if (searchInput) {
                void performSearch(searchInput.value)
            }

            return
        }

        if (
            !target.closest('#search-panel') &&
            !document
                .getElementById('search-panel')
                ?.classList.contains('hidden')
        ) {
            setSearchOpen(false)
        }
    })

    document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return

        const searchPanel =
            document.getElementById('search-panel')

        if (!searchPanel?.classList.contains('hidden')) {
            setSearchOpen(false)
        }
    })

    document.addEventListener('astro:page-load', () => {
        setSearchOpen(false)
    })
</script>


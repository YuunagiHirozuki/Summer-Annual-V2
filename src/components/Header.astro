---
import { SITE_TITLE } from '../consts'
import HeaderLink from './HeaderLink.astro'
import { Icon } from 'astro-icon/components'
---

<nav
    id="navbar"
    class="fixed top-0 z-50 w-full bg-transparent px-4 py-4 transition-all duration-300"
>
    <div class="flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="shrink-0">
            <a href="#top" class="text-2xl text-ink no-underline"
                >{SITE_TITLE}</a
            >
        </div>

        <!-- Links：窄屏横向滚动 -->
        <div
            class="flex min-w-0 space-x-5 overflow-x-auto text-sm text-ink [-ms-overflow-style:none] [scrollbar-width:none] sm:space-x-15 sm:text-base"
        >
            <HeaderLink href="/">BLOG</HeaderLink>
            <HeaderLink href="/projects">PROJECTS</HeaderLink>
            <HeaderLink href="/gallery">GALLERY</HeaderLink>
            <HeaderLink href="#about">ABOUT</HeaderLink>
            <HeaderLink href="#contact">CONTACT</HeaderLink>
            <HeaderLink href="/archive">ARCHIVE</HeaderLink>
        </div>

        <!-- 白天/黑夜切换 -->
        <div class="shrink-0">
            <button
                type="button"
                data-theme-toggle
                aria-label="切换白天/黑夜模式"
                class="flex h-8 w-8 items-center justify-center rounded-full text-ink transition-colors duration-300 hover:bg-ink hover:text-aqua"
            >
                <Icon
                    name="mdi:weather-night"
                    class="theme-icon-dark text-xl"
                />
                <Icon
                    name="mdi:white-balance-sunny"
                    class="theme-icon-light text-xl"
                />
            </button>
        </div>
    </div>
</nav>

<style>
    /* 滚动后导航条变实底（由脚本切换 .nav--scrolled） */
    .nav--scrolled {
        background-color: color-mix(
            in srgb,
            var(--background) 90%,
            transparent
        );
        box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 0.1),
            0 2px 4px -2px rgb(0 0 0 / 0.1);
    }
</style>

<style is:global>
    /* 按当前主题显示对应的切换图标 */
    html[data-theme='dark'] .theme-icon-light {
        display: none;
    }
    html[data-theme='light'] .theme-icon-dark {
        display: none;
    }
</style>

<script>
    // ===== 白天/黑夜切换：事件委托，ClientRouter 换页后依旧有效 =====
    document.addEventListener('click', (event) => {
        const target =
            event.target instanceof Element ? event.target : null
        if (!target?.closest('[data-theme-toggle]')) return
        const next =
            document.documentElement.dataset.theme === 'light'
                ? 'dark'
                : 'light'
        document.documentElement.dataset.theme = next
        localStorage.setItem('theme', next)
    })

    // ===== 导航条：滚过阈值变实底；滑过 hero 后下滑隐藏、上滑出现 =====
    let heroHeight = 400
    let lastScrollY = 0
    let ticking = false

    function updateNavStyle(nav: HTMLElement) {
        const y = window.scrollY
        nav.classList.toggle('nav--scrolled', y > 60)

        if (y > heroHeight) {
            nav.style.transform =
                y > lastScrollY ? 'translateY(-100%)' : 'translateY(0)'
        } else {
            nav.style.transform = 'translateY(0)'
        }
        lastScrollY = y
        ticking = false
    }

    function initHeader() {
        const nav = document.getElementById('navbar')
        if (!nav) return

        // 每次换页重新测量 hero 高度
        heroHeight = document.querySelector('#hero')?.offsetHeight ?? 400

        if (!nav.dataset.bound) {
            nav.dataset.bound = '1'
            window.addEventListener(
                'scroll',
                () => {
                    if (!ticking) {
                        window.requestAnimationFrame(() => updateNavStyle(nav))
                        ticking = true
                    }
                },
                { passive: true }
            )
            window.addEventListener('resize', () => {
                heroHeight = document.querySelector('#hero')?.offsetHeight ?? 400
            })
        }
        updateNavStyle(nav)
    }

    document.addEventListener('astro:page-load', initHeader)
</script>

---
import { SITE_TITLE } from '../consts'
import LogoLight from '../assets/images/SummerAnnual_Light.svg'
import LogoDark from '../assets/images/SummerAnnual_Dark.svg'
import HeaderLink from './HeaderLink.astro'
import { Icon } from 'astro-icon/components'

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '')
const subpath = pathname.match(/[^/]+/g)
const isActive = (href: string) =>
    href === pathname || href === '/' + (subpath?.[0] || '')

const links = [
    { href: '/', label: 'BLOG' },
    { href: '/projects', label: 'PROJECTS' },
    { href: '/gallery', label: 'GALLERY' },
    { href: '#about', label: 'ABOUT' },
    { href: '#contact', label: 'CONTACT' },
    { href: '/archive', label: 'ARCHIVE' },
]
---

<nav
    id="navbar"
    class="fixed top-0 z-50 w-full bg-transparent px-4 py-4 transition-all duration-300"
>
    <div class="flex items-center justify-between gap-4">
        <!-- Logo -->
        <div class="shrink-0">
            <a href="#top" class="block no-underline">
                <img
                    src={LogoLight.src}
                    alt={SITE_TITLE}
                    class="logo-light h-11 w-auto max-w-none"
                />
                <img
                    src={LogoDark.src}
                    alt={SITE_TITLE}
                    class="logo-dark h-11 w-auto max-w-none"
                />
            </a>
        </div>

        <!-- 桌面端链接 -->
        <div class="hidden space-x-15 text-base lg:flex">
            {
                links.map((l) => (
                    <HeaderLink href={l.href}>{l.label}</HeaderLink>
                ))
            }
        </div>

        <div class="flex shrink-0 items-center gap-2">
            <!-- 白天/黑夜切换 -->
            <button
                type="button"
                data-theme-toggle
                aria-label="切换白天/黑夜模式"
                class="flex h-8 w-8 items-center justify-center rounded-full transition-colors duration-300 hover:bg-ink hover:text-aqua"
            >
                <Icon
                    name="mdi:weather-night"
                    class="theme-icon-dark text-xl"
                />
                <Icon
                    name="mdi:white-balance-sunny"
                    class="theme-icon-light text-xl"
                />
            </button>

            <!-- 移动端菜单按钮 -->
            <button
                type="button"
                id="menu-btn"
                aria-label="打开菜单"
                aria-expanded="false"
                aria-controls="mobile-drawer"
                class="flex h-8 w-8 items-center justify-center rounded-full transition-colors duration-300 hover:bg-ink hover:text-aqua lg:hidden"
            >
                <Icon name="mdi:menu" class="text-xl" />
            </button>
        </div>
    </div>
</nav>

<!-- 抽屉遮罩 -->
<div id="drawer-backdrop" class="fixed inset-0 z-40 bg-black/50 lg:hidden">
</div>

<!-- 抽屉：从右侧滑出 -->
<aside
    id="mobile-drawer"
    class="fixed right-0 top-0 z-50 h-full w-64 bg-surface shadow-xl lg:hidden"
    aria-label="站点导航"
>
    <div class="flex h-full flex-col gap-1 overflow-y-auto p-6 pt-20">
        {
            links.map((l) => (
                <a
                    href={l.href}
                    class:list={[
                        'block rounded px-3 py-2 text-base no-underline transition-colors duration-300 hover:text-aqua',
                        isActive(l.href) ? 'text-aqua' : 'text-ink',
                    ]}
                >
                    {l.label}
                </a>
            ))
        }
    </div>
</aside>

<style>
    /* 滚动后导航条变实底（由脚本切换 .nav--scrolled） */
    .nav--scrolled {
        background-color: color-mix(
            in srgb,
            var(--background) 90%,
            transparent
        );
        box-shadow:
            0 4px 6px -1px rgb(0 0 0 / 0.1),
            0 2px 4px -2px rgb(0 0 0 / 0.1);
    }

    /* 抽屉默认收起，.drawer-open 时滑出（从右侧） */
    #mobile-drawer {
        transform: translateX(100%);
        transition: transform 0.3s ease;
    }

    #mobile-drawer.drawer-open {
        transform: translateX(0);
    }

    #drawer-backdrop {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    #drawer-backdrop.drawer-open {
        opacity: 1;
        pointer-events: auto;
    }
</style>

<style is:global>
    /* 按当前主题显示对应的切换图标 */
    html[data-theme='dark'] .theme-icon-light {
        display: none;
    }
    html[data-theme='light'] .theme-icon-dark {
        display: none;
    }

    /* Logo 同理：Light 版（白色）配黑夜模式，Dark 版配白天模式 */
    html[data-theme='dark'] .logo-dark {
        display: none;
    }
    html[data-theme='light'] .logo-light {
        display: none;
    }

    /* 悬浮在 hero 上方（未滚动）时，导航文字/图标跟随 --on-hero，
       不随主题切换变色；滚动出 hero 后用常规 --ink */
    body.has-hero #navbar:not(.nav--scrolled) {
        color: var(--on-hero);
    }
    #navbar.nav--scrolled {
        color: var(--ink);
    }
</style>

<script>
    // ===== 白天/黑夜切换：事件委托，ClientRouter 换页后依旧有效 =====
    document.addEventListener('click', (event) => {
        const target =
            event.target instanceof Element ? event.target : null
        if (!target?.closest('[data-theme-toggle]')) return
        const next =
            document.documentElement.dataset.theme === 'light'
                ? 'dark'
                : 'light'
        document.documentElement.dataset.theme = next
        localStorage.setItem('theme', next)
    })

    // ===== 移动端抽屉菜单 =====
    // 全部用 document 级事件委托：ClientRouter 换页会替换按钮/抽屉节点，
    // 绑在节点上的监听器会随旧节点丢失，委托则始终有效
    function setDrawer(open: boolean) {
        document
            .getElementById('mobile-drawer')
            ?.classList.toggle('drawer-open', open)
        document
            .getElementById('drawer-backdrop')
            ?.classList.toggle('drawer-open', open)
        document
            .getElementById('menu-btn')
            ?.setAttribute('aria-expanded', String(open))
    }

    document.addEventListener('click', (event) => {
        const target =
            event.target instanceof Element ? event.target : null
        if (!target) return
        if (target.closest('#menu-btn')) {
            setDrawer(true)
        } else if (
            target.closest('#drawer-backdrop') ||
            target.closest('#mobile-drawer a')
        ) {
            setDrawer(false)
        }
    })

    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setDrawer(false)
    })

    // ===== 导航条：滚过阈值变实底；滑过 hero 后下滑隐藏、上滑出现 =====
    let heroHeight = 400
    let lastScrollY = 0
    let ticking = false

    function updateNavStyle(nav: HTMLElement) {
        const y = window.scrollY
        nav.classList.toggle('nav--scrolled', y > 60)

        if (y > heroHeight) {
            nav.style.transform =
                y > lastScrollY ? 'translateY(-100%)' : 'translateY(0)'
        } else {
            nav.style.transform = 'translateY(0)'
        }
        lastScrollY = y
        ticking = false
    }

    function initHeader() {
        const nav = document.getElementById('navbar')
        if (!nav) return

        // 换页后抽屉恢复收起
        setDrawer(false)

        // 每次换页重新测量 hero 高度
        heroHeight = document.querySelector('#hero')?.offsetHeight ?? 400

        if (!nav.dataset.bound) {
            nav.dataset.bound = '1'

            window.addEventListener(
                'scroll',
                () => {
                    if (!ticking) {
                        window.requestAnimationFrame(() => updateNavStyle(nav))
                        ticking = true
                    }
                },
                { passive: true }
            )
            window.addEventListener('resize', () => {
                heroHeight = document.querySelector('#hero')?.offsetHeight ?? 400
            })
        }
        updateNavStyle(nav)
    }

    document.addEventListener('astro:page-load', initHeader)
</script>

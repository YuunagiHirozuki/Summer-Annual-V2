---
import CoverImage from './CoverImage.astro'
import { formatDate, type Post } from '../utils/posts'

interface Props {
    post: Post
}

const { post } = Astro.props
---

<div class="overflow-hidden rounded-sm bg-card shadow-xs transition-shadow hover:shadow-sm">
    <a
        href={`/posts/${post.id}/`}
        class="flex items-center gap-4 no-underline"
    >
        {
            post.data.image && (
                <div class="h-20 w-32 shrink-0 overflow-hidden">
                    <CoverImage
                        image={post.data.image}
                        alt={post.data.title}
                        width={300}
                        class="h-full w-full object-cover"
                    />
                </div>
            )
        }
        <div
            class:list={[
                'flex min-w-0 flex-1 items-baseline justify-between gap-4 pr-4',
                post.data.image ? 'py-3' : 'py-3 pl-4',
            ]}
        >
            <span class="truncate text-ink transition-colors hover:text-aqua">
                {post.data.title}
            </span>
            <time
                datetime={post.data.pubDate.toISOString()}
                class="shrink-0 text-sm text-muted"
            >
                {formatDate(post.data.pubDate)}
            </time>
        </div>
    </a>
</div>

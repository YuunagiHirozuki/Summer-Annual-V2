---
const startYear = 2025
const year = new Date().getFullYear()
const displayYear = year === startYear ? '2025' : `2025-${year}`
---

<footer
    class="flex items-center justify-center bg-background p-[2.3em] text-center text-xs text-muted"
>
    &copy; {displayYear} Hiroizuki. All rights reserved. Powered by Astro &amp;
    TailwindCSS.
</footer>

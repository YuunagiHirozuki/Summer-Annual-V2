<button
    id="back-to-top"
    aria-label="回到顶部"
    class="fixed bottom-6 right-6 z-50 flex h-12 w-12 items-center justify-center rounded-full bg-transparent text-2xl text-aqua opacity-0 shadow-lg transition-all duration-300 hover:bg-aqua hover:text-aqua-contrast"
>
    <i class="mi-chevron-up"></i>
</button>

<script>
    let bound = false
    let heroHeight = 400

    function updateButton() {
        const btn = document.getElementById('back-to-top')
        if (!btn) return

        const scrollY = window.scrollY

        // 显示/隐藏按钮
        btn.style.opacity = scrollY > heroHeight ? '1' : '0'
    }

    function initBackToTop() {
        const btn = document.getElementById('back-to-top')
        if (!btn) return

        // 每次换页重新测量
        heroHeight = (document.querySelector('#hero') as HTMLElement | null)?.offsetHeight ?? 400

        if (!bound) {
            bound = true
            window.addEventListener('scroll', updateButton, { passive: true })
            window.addEventListener('resize', updateButton)
            btn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' })
            })
        }
        updateButton()
    }

    document.addEventListener('astro:page-load', initBackToTop)
</script>
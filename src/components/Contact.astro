---
import { SITE_EMAIL } from '../consts'
---

<section
    id="contact"
    class="flex flex-col items-center justify-center bg-aqua p-[3em] text-center text-aqua-contrast shadow-md"
>
    <h2 class="flex items-center justify-center text-2xl font-bold">CONTACT</h2>
    <div class="flex w-full max-w-3xl flex-col items-center justify-center px-8 text-center">
        <p class="mb-0 text-base">如有需要，请通过以下方式与我联系。</p>
        <ul>
            <li class="text-sm leading-snug">{SITE_EMAIL}</li>
        </ul>
    </div>
</section>

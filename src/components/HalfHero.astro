---
interface Props {
    image?: string
}

const { image } = Astro.props
---

<!-- 内页的半屏封面 -->
<a href="#main" class="block w-full">
    <section id="hero" class="relative h-[80vh] w-full overflow-hidden">
        {
            image && (
                <img
                    src={image}
                    alt=""
                    class="absolute inset-0 h-full w-full object-cover object-[center_20%]"
                    loading="eager"
                />
            )
        }

        <!-- 遮罩 -->
        <div class="absolute inset-0 bg-black/40"></div>
    </section>
</a>

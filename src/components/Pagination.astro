---
interface Props {
    currentPage?: number
    totalPages?: number
}

const { currentPage = 1, totalPages = 1 } = Astro.props

// 页码清单：首尾恒显，当前页 ±2 在窗口内，中间的空洞用省略号占位。
// 相邻页码只差 1 时直接显示，差 2 时补上中间那一页，差更多才出省略号
const wanted = [
    ...new Set(
        [
            1,
            totalPages,
            currentPage - 2,
            currentPage - 1,
            currentPage,
            currentPage + 1,
            currentPage + 2,
        ].filter((p) => p >= 1 && p <= totalPages)
    ),
].sort((a, b) => a - b)

const pageItems: Array<{ type: 'page' | 'ellipsis'; page?: number }> = []
let prev = 0
for (const p of wanted) {
    if (p - prev === 2) pageItems.push({ type: 'page', page: p - 1 })
    else if (p - prev > 2) pageItems.push({ type: 'ellipsis' })
    pageItems.push({ type: 'page', page: p })
    prev = p
}

const prevPageHref =
    currentPage === 1
        ? null
        : currentPage - 1 === 1
          ? '/'
          : `/posts/${currentPage - 1}/`
const nextPageHref =
    currentPage === totalPages ? null : `/posts/${currentPage + 1}/`
---

<div class="mt-8 flex items-center justify-center space-x-2">
    <!-- 上一页（无上一页时以 invisible 占位：保留布局位置，页面结构不因翻页移动） -->
    {
        prevPageHref ? (
            <a
                href={prevPageHref}
                aria-label="上一页"
                class="flex h-9 w-9 items-center justify-center rounded text-aqua transition-colors duration-300 hover:bg-aqua hover:text-aqua-contrast"
            >
                <i class="mi-chevron-left text-inherit"></i>
            </a>
        ) : (
            <span
                aria-hidden="true"
                class="invisible flex h-9 w-9 items-center justify-center"
            >
                <i class="mi-chevron-left"></i>
            </span>
        )
    }

    <!-- 页码：当前页渲染为 span + aria-current（"现在在哪"不是链接） -->
    {
        pageItems.map((item) =>
            item.type === 'ellipsis' ? (
                <span
                    aria-hidden="true"
                    class="flex h-9 w-9 items-center justify-center text-muted"
                >
                    …
                </span>
            ) : item.page === currentPage ? (
                <span
                    aria-current="page"
                    class="flex h-9 w-9 items-center justify-center rounded bg-aqua text-aqua-contrast"
                >
                    {item.page}
                </span>
            ) : (
                <a
                    href={item.page === 1 ? '/' : `/posts/${item.page}/`}
                    class="flex h-9 w-9 items-center justify-center rounded text-aqua transition-colors duration-300 hover:bg-aqua hover:text-aqua-contrast"
                >
                    {item.page}
                </a>
            )
        )
    }

    <!-- 下一页（无下一页时以 invisible 占位） -->
    {
        nextPageHref ? (
            <a
                href={nextPageHref}
                aria-label="下一页"
                class="flex h-9 w-9 items-center justify-center rounded text-aqua transition-colors duration-300 hover:bg-aqua hover:text-aqua-contrast"
            >
                <i class="mi-chevron-right text-inherit"></i>
            </a>
        ) : (
            <span
                aria-hidden="true"
                class="invisible flex h-9 w-9 items-center justify-center"
            >
                <i class="mi-chevron-right"></i>
            </span>
        )
    }
</div>

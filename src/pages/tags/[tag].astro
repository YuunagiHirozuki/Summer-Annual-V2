---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostRow from '../../components/PostRow.astro'
import { getSortedPosts, getTagCounts, type Post } from '../../utils/posts'
import { SITE_TITLE } from '../../consts'

export async function getStaticPaths() {
    const posts = await getSortedPosts()
    return getTagCounts(posts).map(([tag]) => ({
        params: { tag },
        props: {
            tag,
            posts: posts.filter((p) => (p.data.tags ?? []).includes(tag)),
        },
    }))
}

interface Props {
    tag: string
    posts: Post[]
}

const { tag, posts } = Astro.props
---

<BaseLayout title={`#${tag} - ${SITE_TITLE}`} hero="half">
    <div class="mx-auto w-full max-w-180 px-4 py-8">
        <h1 class="mb-10 text-center text-3xl font-bold text-aqua">#{tag}</h1>

        <div class="grid gap-2">
            {posts.map((post) => <PostRow post={post} />)}
        </div>
    </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getSortedPosts, getTagCounts } from '../../utils/posts'
import { SITE_TITLE } from '../../consts'

const posts = await getSortedPosts()
const tags = getTagCounts(posts)
---

<BaseLayout title={`Tags - ${SITE_TITLE}`} hero="half">
    <div class="mx-auto w-full max-w-180 px-4 py-8">
        <h1 class="mb-10 text-center text-3xl font-bold">Tags</h1>

        <ul class="grid gap-2">
            {
                tags.map(([tag, count]) => (
                    <li class="rounded-sm bg-card px-4 py-3 shadow-md transition-shadow hover:shadow-lg">
                        <a
                            href={`/tags/${encodeURIComponent(tag)}/`}
                            class="flex items-baseline justify-between gap-4 no-underline"
                        >
                            <span class="text-ink transition-colors hover:text-aqua">
                                #{tag}
                            </span>
                            <span class="shrink-0 text-sm text-muted">
                                {count} 篇
                            </span>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostRow from '../components/PostRow.astro'
import { getSortedPosts } from '../utils/posts'
import { SITE_TITLE } from '../consts'

const posts = (await getSortedPosts()).sort(
    (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
)

const years = [
    ...new Set(posts.map((p) => p.data.pubDate.getFullYear())),
].sort((a, b) => b - a)
---

<BaseLayout title={`Archive - ${SITE_TITLE}`} hero="half">
    <div class="mx-auto w-full max-w-180 px-4 py-8">
        <h1 class="mb-10 text-center text-4xl font-bold">Archive</h1>

        <div class="relative">
            <!-- 顶端从第一个年份圆点的圆心（27px ≈ 2rem × 1.7 行高 ÷ 2）起线，
                 不再向上突出；若调整年份标题字号需同步此值 -->
            <div
                class="absolute left-0 top-[27px] bottom-0 w-0.5 bg-border"
                aria-hidden="true"
            >
            </div>

            {
                years.map((year) => (
                    <section class="relative mb-12 pl-8">
                        <h2 class="relative mb-4 text-[2rem] font-bold text-aqua">
                            <span
                                class="absolute -left-[39px] top-1/2 h-4 w-4 -translate-y-1/2 rounded-full border-4 border-aqua bg-background"
                                aria-hidden="true"
                            />
                            {year}
                        </h2>
                        <div class="grid gap-2">
                            {posts
                                .filter(
                                    (p) =>
                                        p.data.pubDate.getFullYear() === year
                                )
                                .map((post) => (
                                    <div class="relative">
                                        <span
                                            class="absolute -left-9 top-1/2 h-2.5 w-2.5 -translate-y-1/2 rounded-full bg-aqua"
                                            aria-hidden="true"
                                        />
                                        <PostRow post={post} />
                                    </div>
                                ))}
                        </div>
                    </section>
                ))
            }
        </div>
    </div>
</BaseLayout>

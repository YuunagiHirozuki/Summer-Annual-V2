---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostRow from '../components/PostRow.astro'
import { getSortedPosts } from '../utils/posts'
import { SITE_TITLE } from '../consts'

const posts = await getSortedPosts()
const years = [...new Set(posts.map((p) => p.data.pubDate.getFullYear()))]
---

<BaseLayout title={`Archive - ${SITE_TITLE}`} hero="half">
    <div class="mx-auto w-full max-w-180 px-4 py-8">
        <h1 class="mb-10 text-center text-3xl font-bold">Archive</h1>

        {/* 地铁线式时间线：竖线贯穿，年份是大站，每篇文章是一个小站 */}
        <div class="relative">
            <div
                class="absolute inset-y-0 left-0 w-0.5 bg-border"
                aria-hidden="true"
            >
            </div>

            {
                years.map((year) => (
                    <section class="relative mb-12 pl-8">
                        <span
                            class="absolute -left-[7px] top-0 h-4 w-4 rounded-full border-2 border-aqua bg-background"
                            aria-hidden="true"
                        />
                        <h2 class="mb-4 text-2xl font-bold text-aqua">
                            {year}
                        </h2>
                        <div class="grid gap-2">
                            {posts
                                .filter(
                                    (p) =>
                                        p.data.pubDate.getFullYear() === year
                                )
                                .map((post) => (
                                    <div class="relative">
                                        <span
                                            class="absolute -left-9 top-1/2 h-2.5 w-2.5 -translate-y-1/2 rounded-full bg-aqua"
                                            aria-hidden="true"
                                        />
                                        <PostRow post={post} />
                                    </div>
                                ))}
                        </div>
                    </section>
                ))
            }
        </div>
    </div>
</BaseLayout>

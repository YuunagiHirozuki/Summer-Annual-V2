---
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import Pagination from '../components/Pagination.astro'
import TagWidget from '../components/TagWidget.astro'
import { getSortedPosts, POSTS_PER_PAGE } from '../utils/posts'
import { SITE_DESCRIPTION, SITE_SIGNATURE, SITE_TITLE } from '../consts'

const posts = await getSortedPosts()
const totalPages = Math.ceil(posts.length / POSTS_PER_PAGE)
const visiblePosts = posts.slice(0, POSTS_PER_PAGE)
---

<BaseLayout
    title={`BLOG - ${SITE_TITLE}`}
    description={SITE_DESCRIPTION}
    hero="full"
>
    {/* 左占位与右侧 TAGS 同宽，让中间内容精确居中 */}
    <div class="flex items-start gap-8 px-4 py-8">
        <div class="hidden w-72 shrink-0 xl:block" aria-hidden="true"></div>

        <div class="mx-auto w-full max-w-200 min-w-0">
            <!-- 公告栏 -->
            <div class="mb-6 rounded-sm bg-card p-6 shadow-md">
                <p class="text-muted">{SITE_SIGNATURE}</p>
            </div>

            <div class="grid gap-6">
                {visiblePosts.map((post) => <PostCard post={post} />)}
            </div>

            <Pagination currentPage={1} totalPages={totalPages} />
        </div>

        <TagWidget />
    </div>
</BaseLayout>

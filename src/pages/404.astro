---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../consts'
---

<BaseLayout title={`404 - ${SITE_TITLE}`} hero="none">
    <div
        class="mx-auto flex w-full max-w-180 flex-col items-center px-4 py-24 text-center"
    >
        <!-- 中央图片位：把图片放到 public/images/404.png（或改下面的 src）即会显示 -->
        <img
            id="error-404-img"
            src="/images/404.png"
            alt="404"
            class="mb-6 max-w-xs"
            hidden
        />

        <h1 class="text-6xl font-bold text-aqua">404</h1>
        <p class="mt-4 text-muted">页面不存在，或已被移动。</p>

        <a
            href="/"
            class="mt-8 rounded-sm bg-surface px-5 py-2 text-sm no-underline transition-colors hover:text-aqua"
        >
            回首页
        </a>
    </div>
</BaseLayout>

<script is:inline>
    // 图片文件存在才显示，避免占位期出现破图
    const img = document.getElementById('error-404-img')
    if (img) {
        img.addEventListener('load', () => (img.hidden = false))
        img.addEventListener('error', () => (img.hidden = true))
        if (img.complete) img.hidden = img.naturalWidth === 0
    }
</script>

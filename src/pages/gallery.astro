---
import { getGalleryImages } from '../utils/gallery'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../consts'

// 画廊布局开关：
//   false = 变体 2：居中相册网格，行内垂直居中
//   true  = 变体 1：满屏相册墙（固定 4 列，图片随窗口放大；
//           图 ≥ 20 张后才有好效果）
const FULLBLEED_WALL = false

const artworks = await getGalleryImages()
---

<BaseLayout title={`Gallery - ${SITE_TITLE}`} hero="half">
    <div
        id="gallery-wall"
        class:list={[FULLBLEED_WALL ? 'w-full py-8' : 'mx-auto w-full max-w-260 px-4 py-8']}
    >
        {
            FULLBLEED_WALL ? (
                <div class="mx-auto w-full max-w-260 px-4">
                    <h1 class="text-center text-4xl font-bold text-aqua">Gallery</h1>
                    <div class="mt-2 mb-4 h-0.5 bg-aqua/50"></div>
                </div>
            ) : (
                <>
                    <h1 class="text-center text-4xl font-bold text-aqua">Gallery</h1>
                    <div class="mt-2 mb-4 h-0.5 bg-aqua/50"></div>
                </>
            )
        }
        {
            artworks.length > 0 ? (
                <div
                    class:list={[
                        'gallery-grid grid grid-cols-3 items-center gap-x-3 gap-y-6',
                        FULLBLEED_WALL
                            ? 'px-2 md:grid-cols-4 lg:gap-3'
                            : 'lg:gap-x-6 lg:gap-y-12 lg:grid-cols-4 2xl:grid-cols-5',
                    ]}
                >
                    {artworks.map((art) => (
                        <a
                            href={art.src}
                            data-pswp-src={art.full}
                            class="block"
                        >
                            <img
                                src={art.src}
                                alt={art.alt}
                                loading="lazy"
                                decoding="async"
                                draggable="false"
                                class="w-full"
                            />
                        </a>
                    ))}
                </div>
            ) : (
                <div class="rounded-sm bg-card p-6 shadow-xs">
                    <p class="text-muted">
                        画廊筹备中…… 把图片上传到 R2 bucket 的 gallery/ 目录后，
                        触发一次网站构建即可展示（见仓库 README 的画廊说明）。
                    </p>
                </div>
            )
        }
    </div>
</BaseLayout>

<style is:global>
    /* 画廊墙：去蓝调的中性展墙
       仅在本页（含 #gallery-wall 的页面）生效，其他页面不受影响 */
    html[data-theme='dark'] body:has(#gallery-wall) {
        background-color: #1e1f21;
    }
    html[data-theme='light'] body:has(#gallery-wall) {
        background-color: #f6f6f4;
    }
</style>

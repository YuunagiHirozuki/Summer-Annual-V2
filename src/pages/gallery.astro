---
import type { ImageMetadata } from 'astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../consts'

// 画廊：把图片扔进 src/assets/gallery/ 即可，文件名排序即展示顺序
// （建议 01-xxx.png、02-xxx.png 编号命名）
const images = Object.entries(
    import.meta.glob<{ default: ImageMetadata }>(
        '/src/assets/gallery/*.{webp,png,jpg,jpeg,gif,avif}',
        { eager: true }
    )
).sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))

const artworks = images.map(([path, mod]) => ({
    src: mod.default.src,
    width: mod.default.width,
    height: mod.default.height,
    alt: path.split('/').pop()?.replace(/\.[^.]+$/, '') ?? '作品',
}))
---

<BaseLayout title={`Gallery - ${SITE_TITLE}`} hero="half">
    <div class="mx-auto w-full max-w-260 px-4 py-8">
        <h1 class="mb-10 text-center text-3xl font-bold">Gallery</h1>

        {
            artworks.length > 0 ? (
                <div class="columns-1 gap-8 sm:columns-2 lg:columns-3">
                    {artworks.map((art) => (
                        <img
                            src={art.src}
                            alt={art.alt}
                            width={art.width}
                            height={art.height}
                            loading="lazy"
                            decoding="async"
                            class="mb-8 w-full break-inside-avoid"
                        />
                    ))}
                </div>
            ) : (
                <div class="rounded-sm bg-card p-6 shadow-md">
                    <p class="text-muted">
                        画廊筹备中…… 把图片放进 src/assets/gallery/ 即可展示。
                    </p>
                </div>
            )
        }
    </div>
</BaseLayout>

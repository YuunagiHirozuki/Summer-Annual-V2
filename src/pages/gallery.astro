---
import { getGalleryImages } from '../utils/gallery'
import BaseLayout from '../layouts/BaseLayout.astro'
import { SITE_TITLE } from '../consts'

const artworks = await getGalleryImages()
---

<BaseLayout title={`Gallery - ${SITE_TITLE}`} hero="half">
    <div class="mx-auto w-full max-w-260 px-4 py-8">
        <h1 class="text-center text-3xl font-bold">Gallery</h1>
        <div class="my-10 h-0.5 bg-aqua"></div>
        {
            artworks.length > 0 ? (
                <div class="gallery-grid columns-1 gap-8 sm:columns-2 lg:columns-3">
                    {artworks.map((art) => (
                        <a
                            href={art.src}
                            data-pswp-src={art.src}
                            class="mb-8 block break-inside-avoid"
                        >
                            <img
                                src={art.src}
                                alt={art.alt}
                                loading="lazy"
                                decoding="async"
                                draggable="false"
                                class="w-full"
                            />
                        </a>
                    ))}
                </div>
            ) : (
                <div class="rounded-sm bg-card p-6 shadow-xs">
                    <p class="text-muted">
                        画廊筹备中…… 把图片上传到 R2 bucket 的 gallery/ 目录后，
                        触发一次网站构建即可展示（见仓库 README 的画廊说明）。
                    </p>
                </div>
            )
        }
    </div>
</BaseLayout>
